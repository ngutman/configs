# Font
font-family = "JetBrains Mono"
font-size = 13.5

# Layout
window-padding-x = 6
window-padding-y = 6
window-padding-balance = true

# Cursor
cursor-style = bar
cursor-style-blink = false

# Scrollback (bytes)
scrollback-limit = 100000000

# Shell integration
shell-integration = detect

# Treat macOS Option as Alt/Meta for terminal apps like tmux.
macos-option-as-alt = true

# Keybinds
keybind = cmd+left=previous_tab
keybind = cmd+right=next_tab
keybind = cmd+shift+left=move_tab:-1
keybind = cmd+shift+right=move_tab:1
keybind = cmd+shift+d=new_split:right
keybind = cmd+shift+e=new_split:down
keybind = cmd+=increase_font_size:1
keybind = cmd+-=decrease_font_size:1
keybind = cmd+0=reset_font_size
keybind = cmd+shift+,=reload_config

# Make Shift+Enter distinguishable for terminal TUIs (pi uses Shift+Enter to insert a newline).
# This sends an xterm/Kitty-style CSI-u sequence: ESC [ 13 ; 2 u
keybind = shift+enter=text:\x1b[13;2u
